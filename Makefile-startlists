NAME := $(shell printf '%s\n' "$(RACE_DIR)" | sed -E 's/^[0-9]{8}-?//')

startlists:
	startlist --crossmgr racedb.wimsey.online --host racedb.wg --date $(DATE) --name "$(NAME)"
